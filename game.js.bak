
// ═══════════════════════════════════════════════════
//  КЛИНОК И АРКАНА  —  Псевдо-3D Arena
// ═══════════════════════════════════════════════════

// ── Утилиты
const rnd   = (a,b) => Math.random()*(b-a)+a;
const rndI  = (a,b) => Math.floor(rnd(a,b+1));
const clamp = (v,lo,hi) => Math.max(lo,Math.min(hi,v));
const dist2 = (a,b) => Math.hypot(a.wx-b.wx, a.wz-b.wz);

// ── Изометрия
const ISO  = 54;
function toScreen(wx,wz){ return { sx:(wx-wz)*ISO, sy:(wx+wz)*ISO*0.5 }; }
let camX=0, camY=0;
function w2c(wx,wz,wy=0){
  const {sx,sy}=toScreen(wx,wz);
  return {cx:camX+sx, cy:camY+sy - wy*ISO*0.55};
}

// ── Canvas
const arena = document.getElementById("arena");
const ctx   = arena.getContext("2d");
const AW=14, AD=10; // ширина/глубина поля в ячейках

// Спрайт мечника (из пользовательского изображения)
const swordsmanImg = new Image();
swordsmanImg.src = "image/Gemini_Generated_Image_l80991l80991l809.png";

function resizeCam(){
  arena.width  = arena.offsetWidth  || window.innerWidth;
  arena.height = arena.offsetHeight || window.innerHeight;
  const {sx,sy}=toScreen(AW/2, AD/2);
  camX = arena.width/2  - sx;
  camY = arena.height*0.38 - sy;
}
window.addEventListener("resize", resizeCam);

// ══ ЧАСТИЦЫ ══════════════════════════════════════
const PARTS=[];
function parts(cx,cy,col,n=7,spd=2.5){
  for(let i=0;i<n;i++){
    const a=rnd(0,Math.PI*2);
    PARTS.push({x:cx,y:cy,vx:Math.cos(a)*rnd(.5,spd),vy:Math.sin(a)*rnd(.4,spd),
      r:rnd(2,5),col,life:1,dec:rnd(.04,.09)});
  }
}
function tickParts(dt){
  for(let i=PARTS.length-1;i>=0;i--){
    const p=PARTS[i];
    p.x+=p.vx*(dt/16); p.y+=p.vy*(dt/16); p.vy+=.06;
    p.life-=p.dec*(dt/16);
    if(p.life<=0) PARTS.splice(i,1);
  }
}
function drawParts(){
  PARTS.forEach(p=>{
    ctx.save(); ctx.globalAlpha=Math.max(0,p.life);
    ctx.fillStyle=p.col; ctx.beginPath();
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill(); ctx.restore();
  });
}

// ══ ТЕКСТ УРОНА ══════════════════════════════════
const DMGT=[];
function dmgt(x,y,text,col="#fff"){
  DMGT.push({x,y,vy:-1.6,text,col,life:1,dec:.025});
}
function tickDmgt(dt){
  for(let i=DMGT.length-1;i>=0;i--){
    const t=DMGT[i]; t.y+=t.vy*(dt/16); t.life-=t.dec*(dt/16);
    if(t.life<=0) DMGT.splice(i,1);
  }
}
function drawDmgt(){
  DMGT.forEach(t=>{
    ctx.save(); ctx.globalAlpha=Math.max(0,t.life);
    ctx.font="bold 16px Manrope,sans-serif"; ctx.fillStyle=t.col;
    ctx.textAlign="center"; ctx.shadowColor="rgba(0,0,0,.9)"; ctx.shadowBlur=5;
    ctx.fillText(t.text,t.x,t.y); ctx.restore();
  });
}

// ══ СНАРЯДЫ ════════════════════════════════════════
const PROJ=[];
function proj(owner,target,dmg,col,r=8){
  const p=w2c(owner.wx,owner.wz,.8);
  PROJ.push({owner,target,x:p.cx,y:p.cy,dmg,col,r});
}
function tickProj(dt){
  for(let i=PROJ.length-1;i>=0;i--){
    const p=PROJ[i];
    if(p.target.dead){PROJ.splice(i,1);continue;}
    const tp=w2c(p.target.wx,p.target.wz,.8);
    const dx=tp.cx-p.x, dy=tp.cy-p.y, d=Math.hypot(dx,dy);
    const spd=9*(dt/16);
    if(d<spd+p.r){
      dealDmg(p.owner,p.target,p.dmg);
      parts(tp.cx,tp.cy,p.col,8,3);
      PROJ.splice(i,1);
    } else { p.x+=dx/d*spd; p.y+=dy/d*spd; }
  }
}
function drawProj(){
  PROJ.forEach(p=>{
    ctx.save(); ctx.shadowColor=p.col; ctx.shadowBlur=18;
    ctx.fillStyle=p.col; ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=.35; ctx.beginPath(); ctx.arc(p.x,p.y,p.r*2,0,Math.PI*2); ctx.fill();
    ctx.restore();
  });
}

// ══ УТИЛИТЫ ЦВЕТА ══════════════════════════════════
function hexRGB(h){ return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)]; }
function darken(h,a){ try{const[r,g,b]=hexRGB(h);return`rgb(${~~(r*a)},${~~(g*a)},${~~(b*a)})`;}catch{return h;} }
function lighten(h,a){ try{const[r,g,b]=hexRGB(h);return`rgb(${~~(r+(255-r)*a)},${~~(g+(255-g)*a)},${~~(b+(255-b)*a)})`;}catch{return h;} }
function rrect(c,x,y,w,h,r){
  if(w<=0||h<=0)return; c.beginPath();
  c.moveTo(x+r,y); c.lineTo(x+w-r,y); c.quadraticCurveTo(x+w,y,x+w,y+r);
  c.lineTo(x+w,y+h-r); c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  c.lineTo(x+r,y+h); c.quadraticCurveTo(x,y+h,x,y+h-r);
  c.lineTo(x,y+r); c.quadraticCurveTo(x,y,x+r,y); c.closePath(); c.fill();
}
function rrPath(c,x,y,w,h,r){
  if(w<=0||h<=0)return;
  c.beginPath();
  c.moveTo(x+r,y); c.lineTo(x+w-r,y); c.quadraticCurveTo(x+w,y,x+w,y+r);
  c.lineTo(x+w,y+h-r); c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  c.lineTo(x+r,y+h); c.quadraticCurveTo(x,y+h,x,y+h-r);
  c.lineTo(x,y+r); c.quadraticCurveTo(x,y,x+r,y); c.closePath();
}

// ══ РИСОВАНИЕ ПОЛА И СТЕН ══════════════════════════
const tileClr=["#0d2040","#0e2244","#112040","#0f2346","#112244"];
function drawFloor(){
  for(let z=0;z<AD;z++) for(let x=0;x<AW;x++){
    const tl=w2c(x,z), tr=w2c(x+1,z), br=w2c(x+1,z+1), bl=w2c(x,z+1);
    ctx.beginPath();
    ctx.moveTo(tl.cx,tl.cy); ctx.lineTo(tr.cx,tr.cy);
    ctx.lineTo(br.cx,br.cy); ctx.lineTo(bl.cx,bl.cy); ctx.closePath();
    ctx.fillStyle=tileClr[(x+z*3)%5]; ctx.fill();
    ctx.strokeStyle="rgba(255,255,255,.04)"; ctx.lineWidth=.5; ctx.stroke();
  }
}
function drawWalls(){
  const h=ISO*.55;
  // левая стена
  for(let z=0;z<AD;z++){
    const t=w2c(0,z), b=w2c(0,z+1);
    ctx.fillStyle="#07162a";
    ctx.beginPath(); ctx.moveTo(t.cx,t.cy); ctx.lineTo(b.cx,b.cy);
    ctx.lineTo(b.cx,b.cy+h); ctx.lineTo(t.cx,t.cy+h); ctx.closePath(); ctx.fill();
    ctx.strokeStyle="rgba(255,255,255,.05)"; ctx.lineWidth=.5; ctx.stroke();
  }
  // дальняя стена
  for(let x=0;x<AW;x++){
    const l=w2c(x,AD), r=w2c(x+1,AD);
    ctx.fillStyle="#091828";
    ctx.beginPath(); ctx.moveTo(l.cx,l.cy); ctx.lineTo(r.cx,r.cy);
    ctx.lineTo(r.cx,r.cy+h); ctx.lineTo(l.cx,l.cy+h); ctx.closePath(); ctx.fill();
    ctx.strokeStyle="rgba(255,255,255,.05)"; ctx.lineWidth=.5; ctx.stroke();
  }
}

// ══ КЛАСС ЮНИТА ════════════════════════════════════
class Unit {
  constructor(o){
    this.name=o.name||"?"; this.role=o.role||"unit";
    this.wx=o.wx??3; this.wz=o.wz??3; this.wy=0;
    this.hp=o.hp??100; this.maxHp=o.hp??100;
    this.mp=o.mp??0; this.maxMp=o.mp??0;
    this.spd=o.spd??3; this.atk=o.atk??[15,22];
    this.atkRange=o.atkRange??1.2; this.atkCd=o.atkCd??900;
    this.atkTimer=rnd(0,o.atkCd??900);
    this.color=o.color||"#73a5ff"; this.isHero=!!o.isHero;
    this.r=o.r??22; this.facing=this.isHero?1:-1;
    this.walkP=0; this.state="idle"; this.atkAnim=0;
    this.flashT=0; this.flashC="#fff";
    this.dead=false; this.poisonTicks=0; this.poisonDmg=0; this.poisonTimer=0;
    this.spawnShield=0;
    this.ab1Cd=0; this.ab1Max=o.ab1Max??5000;
    this.ab2Cd=0; this.ab2Max=o.ab2Max??8000;
  }
  get enemy(){ return this.isHero?monsters:[player]; }
  closest(){
    let best=null,bd=Infinity;
    for(const u of this.enemy){ if(!u||u.dead)continue; const d=dist2(this,u); if(d<bd){bd=d;best=u;} }
    return best;
  }
  hit(amount){
    this.hp=clamp(this.hp-amount,0,this.maxHp);
    this.flashT=performance.now()+200; this.flashC=this.isHero?"#ff4444":"#ffee44";
    if(this.hp<=0){this.dead=true;onDeath(this);}
  }
  aiUpdate(dt){
    if(this.dead)return;
    // Пока игрок не подошёл — монстры стоят и смотрят в сторону игрока
    if(!battleActive){
      if(player) this.facing=player.wx>this.wx?1:-1;
      this.state="idle"; return;
    }
    this.atkTimer=Math.max(0,this.atkTimer-dt);
    if(this.atkAnim>0) this.atkAnim=Math.max(0,this.atkAnim-dt/280);
    const t=this.closest(); if(!t){this.state="idle";return;}
    const d=dist2(this,t); this.facing=t.wx>this.wx?1:-1;
    if(d<=this.atkRange){
      this.state="attack";
      if(this.atkTimer===0){
        this.atkTimer=this.atkCd; this.atkAnim=1; this.doSwing(t);
      }
    } else {
      this.state="move";
      const dx=t.wx-this.wx, dz=t.wz-this.wz, l=Math.hypot(dx,dz)||1;
      const s=this.spd*(dt/1000);
      this.wx=clamp(this.wx+dx/l*s,.2,AW-.2);
      this.wz=clamp(this.wz+dz/l*s,.2,AD-.2);
      this.walkP+=dt*.008;
    }
  }
  doSwing(t){ dealDmg(this,t,rndI(this.atk[0],this.atk[1])); }

  // ── Псевдо-3D рисование человека ──────────────────
  draw(){
    const {cx,cy}=w2c(this.wx,this.wz,this.wy);
    const bob=(this.state==="move")?Math.sin(this.walkP)*2.5:0;
    const aoff=this.atkAnim*this.facing*8;
    const flash=performance.now()<this.flashT;
    const s=this.r/22;
    // тень
    ctx.save(); ctx.globalAlpha=.22; ctx.fillStyle="#000";
    ctx.beginPath(); ctx.ellipse(cx,cy+this.r*.55,this.r*.95,this.r*.28,0,0,Math.PI*2); ctx.fill(); ctx.restore();
    // тело
    ctx.save();
    if(this.dead) ctx.globalAlpha=.3;
    if(this.isHero && this.role==="Мечник" && swordsmanImg.complete && swordsmanImg.naturalWidth>0){
      this._swordsmanSprite(cx+aoff, cy+bob, s, flash);
    } else {
      this._body(cx+aoff, cy+bob, s, flash);
    }
    ctx.restore();
    if(!this.dead) this._hpbar(cx, cy-this.r*2.1-6);
  }
  _swordsmanSprite(cx,cy,s,fl){
    const f = this.facing;
    const walk = (this.state==="move") ? Math.sin(this.walkP) : 0;
    const atk  = this.atkAnim; // 0→1
    const T = performance.now();

    // ── цвета ──────────────────────────────────────
    const ARMOR   = fl ? "#7aaeff" : "#1c2233";
    const ARMOR_H = fl ? "#b0d0ff" : "#2a3a5c";   // синий акцент
    const ARMOR_L = fl ? "#ffffff" : "#333d55";   // грань
    const CAPE    = fl ? "#8888ff" : "#0d1020";
    const SKIN    = fl ? "#ffffff" : "#f0c090";
    const HAIR    = fl ? "#aaccff" : "#111111";
    const BLADE   = fl ? "#ffffff" : "#c8d8ff";
    const GUARD   = fl ? "#ffffff" : "#5577aa";
    const GLOW    = "#3366ff";
    const sc = s * 1.15;  // масштаб

    ctx.save();
    ctx.translate(cx, cy);
    if(f < 0) ctx.scale(-1, 1);

    // --- ПЛАЩ (за спиной, рисуем первым) ---
    const capeSwing = walk * 6 * sc + atk * (-10) * sc;
    ctx.fillStyle = CAPE;
    ctx.beginPath();
    ctx.moveTo(-4*sc, -14*sc);
    ctx.quadraticCurveTo(-14*sc + capeSwing, 2*sc, -10*sc + capeSwing*1.4, 26*sc);
    ctx.lineTo(-2*sc + capeSwing*0.8, 28*sc);
    ctx.quadraticCurveTo(-5*sc, 8*sc, 2*sc, -12*sc);
    ctx.closePath();
    ctx.fill();
    // подбивка плаща
    ctx.fillStyle = ARMOR_H;
    ctx.globalAlpha = 0.45;
    ctx.beginPath();
    ctx.moveTo(-4*sc, -10*sc);
    ctx.quadraticCurveTo(-10*sc + capeSwing, 4*sc, -8*sc + capeSwing*1.2, 24*sc);
    ctx.lineTo(-4*sc + capeSwing*0.7, 25*sc);
    ctx.quadraticCurveTo(-3*sc, 6*sc, 0*sc, -9*sc);
    ctx.closePath();
    ctx.fill();
    ctx.globalAlpha = 1;

    // --- НОГИ ---
    const legR = walk * 12 * sc;
    const legL = -legR;
    // правая нога
    ctx.strokeStyle = ARMOR; ctx.lineWidth = 6*sc; ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(3*sc, 14*sc);
    ctx.lineTo(6*sc + legR, 26*sc);
    ctx.lineTo(7*sc + legR, 30*sc);
    ctx.stroke();
    // левая нога
    ctx.beginPath();
    ctx.moveTo(-1*sc, 14*sc);
    ctx.lineTo(-4*sc + legL, 26*sc);
    ctx.lineTo(-5*sc + legL, 30*sc);
    ctx.stroke();
    // наколенники
    [6*sc + legR, -4*sc + legL].forEach((lx, i) => {
      const ly = 26*sc;
      ctx.fillStyle = ARMOR_H;
      ctx.beginPath(); ctx.ellipse(lx+(i===0?1:-1)*sc, ly, 4*sc, 3*sc, 0, 0, Math.PI*2); ctx.fill();
    });
    // ступни
    [[7*sc+legR, 30*sc], [-5*sc+legL, 30*sc]].forEach(([fx, fy])=>{
      ctx.fillStyle = "#111827";
      ctx.beginPath(); ctx.ellipse(fx+sc, fy+1*sc, 4.5*sc, 2*sc, 0.2, 0, Math.PI*2); ctx.fill();
    });

    // --- ТОРС (основной) ---
    // нижняя часть (пояс / юбка)
    ctx.fillStyle = ARMOR;
    ctx.beginPath();
    ctx.moveTo(-8*sc, 8*sc);
    ctx.lineTo(8*sc, 8*sc);
    ctx.lineTo(7*sc, 16*sc);
    ctx.lineTo(-7*sc, 16*sc);
    ctx.closePath(); ctx.fill();
    // боковые грани (объём)
    ctx.fillStyle = darken("#1c2233", 0.5);
    ctx.beginPath();
    ctx.moveTo(8*sc, 8*sc);
    ctx.lineTo(11*sc, 6*sc);
    ctx.lineTo(10*sc, 15*sc);
    ctx.lineTo(7*sc, 16*sc);
    ctx.closePath(); ctx.fill();
    // передний нагрудник
    ctx.fillStyle = ARMOR;
    rrPath(ctx, -8*sc, -12*sc, 16*sc, 20*sc, 3*sc);
    ctx.fill();
    // грудная пластина блик
    ctx.fillStyle = ARMOR_L;
    ctx.beginPath();
    ctx.moveTo(-5*sc, -11*sc);
    ctx.lineTo(-2*sc, -11*sc);
    ctx.lineTo(-3*sc, 5*sc);
    ctx.lineTo(-6*sc, 5*sc);
    ctx.closePath(); ctx.fill();
    // синий ромб — центральный акцент (как на арте)
    ctx.fillStyle = ARMOR_H;
    ctx.shadowColor = GLOW; ctx.shadowBlur = fl ? 14 : 8;
    ctx.beginPath();
    ctx.moveTo(0, -6*sc);
    ctx.lineTo(3*sc, -2*sc);
    ctx.lineTo(0, 2*sc);
    ctx.lineTo(-3*sc, -2*sc);
    ctx.closePath(); ctx.fill();
    ctx.shadowBlur = 0;
    // ремни
    ctx.strokeStyle = "#3a2a14"; ctx.lineWidth = 1.5*sc;
    ctx.beginPath(); ctx.moveTo(-8*sc, -4*sc); ctx.lineTo(8*sc, -4*sc); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(-3*sc, -12*sc); ctx.lineTo(-3*sc, 16*sc); ctx.stroke();

    // --- НАПЛЕЧНИКИ ---
    [[9*sc, -10*sc], [-9*sc, -10*sc]].forEach(([px, py]) => {
      ctx.fillStyle = ARMOR_L;
      ctx.beginPath(); ctx.ellipse(px, py, 6*sc, 4.5*sc, px>0?-0.3:0.3, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = ARMOR_H;
      ctx.beginPath(); ctx.ellipse(px, py-1*sc, 5*sc, 2.5*sc, px>0?-0.3:0.3, 0, Math.PI*2); ctx.fill();
    });

    // --- РУКИ ---
    const atkSwingR =  atk * 22 * sc;
    const atkSwingL = -atk * 10 * sc;
    // правая рука
    ctx.strokeStyle = ARMOR; ctx.lineWidth = 5*sc; ctx.lineCap = "round";
    ctx.beginPath();
    ctx.moveTo(8*sc, -8*sc);
    ctx.lineTo(13*sc + atkSwingR, 4*sc + atkSwingR*0.4);
    ctx.stroke();
    // левая рука
    ctx.beginPath();
    ctx.moveTo(-8*sc, -8*sc);
    ctx.lineTo(-13*sc + atkSwingL, 4*sc);
    ctx.stroke();
    // перчатки
    ctx.fillStyle = "#0d1520";
    ctx.beginPath(); ctx.arc(13*sc + atkSwingR, 5*sc + atkSwingR*0.4, 3.5*sc, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(-13*sc + atkSwingL, 5*sc, 3.5*sc, 0, Math.PI*2); ctx.fill();

    // --- МЕЧ 1 (правая рука, длинный) ---
    const sxR = 15*sc + atkSwingR;
    const syR = -24*sc + atkSwingR*0.6;
    ctx.save();
    ctx.translate(sxR, syR + 5*sc);
    ctx.rotate(atk * 0.45);
    // рукоять
    ctx.fillStyle = "#2a1a0a"; ctx.strokeStyle = "#5a3a1a"; ctx.lineWidth = sc;
    rrPath(ctx, -2*sc, 8*sc, 4*sc, 10*sc, 1.5*sc); ctx.fill(); ctx.stroke();
    // гарда
    ctx.fillStyle = GUARD; ctx.strokeStyle = ARMOR_H; ctx.lineWidth = 0.8*sc;
    ctx.beginPath();
    ctx.ellipse(0, 8*sc, 7*sc, 2.5*sc, 0.2, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    // клинок
    ctx.strokeStyle = BLADE; ctx.lineWidth = 3.5*sc; ctx.lineCap = "round";
    if(fl){ ctx.shadowColor = "#aaccff"; ctx.shadowBlur = 12; }
    ctx.beginPath(); ctx.moveTo(0, 7*sc); ctx.lineTo(0, -22*sc); ctx.stroke();
    // блик на лезвии
    ctx.strokeStyle = "rgba(255,255,255,0.6)"; ctx.lineWidth = 1.2*sc;
    ctx.beginPath(); ctx.moveTo(0.8*sc, 6*sc); ctx.lineTo(0.8*sc, -18*sc); ctx.stroke();
    ctx.shadowBlur = 0;
    // наконечник
    ctx.fillStyle = BLADE;
    ctx.beginPath(); ctx.moveTo(-1.5*sc, -22*sc); ctx.lineTo(0, -28*sc); ctx.lineTo(1.5*sc, -22*sc); ctx.closePath(); ctx.fill();
    ctx.restore();

    // --- МЕЧ 2 (левая рука, чуть короче, обратный хват) ---
    const sxL = -14*sc + atkSwingL;
    const syL = -16*sc;
    ctx.save();
    ctx.translate(sxL, syL + 5*sc);
    ctx.rotate(-0.3 + atk * (-0.3));
    // рукоять
    ctx.fillStyle = "#1a0a0a"; ctx.strokeStyle = "#4a2a1a"; ctx.lineWidth = sc;
    rrPath(ctx, -1.8*sc, 6*sc, 3.6*sc, 8*sc, 1.5*sc); ctx.fill(); ctx.stroke();
    // гарда
    ctx.fillStyle = "#334466"; ctx.strokeStyle = ARMOR_H; ctx.lineWidth = 0.8*sc;
    ctx.beginPath(); ctx.ellipse(0, 6*sc, 5.5*sc, 2*sc, -0.1, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    // клинок (чуть темнее)
    ctx.strokeStyle = "#a0b8e0"; ctx.lineWidth = 2.5*sc; ctx.lineCap = "round";
    ctx.beginPath(); ctx.moveTo(0, 5*sc); ctx.lineTo(0, -16*sc); ctx.stroke();
    ctx.strokeStyle = "rgba(255,255,255,0.45)"; ctx.lineWidth = sc;
    ctx.beginPath(); ctx.moveTo(0.6*sc, 4*sc); ctx.lineTo(0.6*sc, -13*sc); ctx.stroke();
    // наконечник
    ctx.fillStyle = "#a0b8e0";
    ctx.beginPath(); ctx.moveTo(-1.2*sc, -16*sc); ctx.lineTo(0, -21*sc); ctx.lineTo(1.2*sc, -16*sc); ctx.closePath(); ctx.fill();
    ctx.restore();

    // --- ГОЛОВА ---
    // шея
    ctx.fillStyle = SKIN;
    ctx.beginPath(); ctx.ellipse(0, -14*sc, 3.5*sc, 3*sc, 0, 0, Math.PI*2); ctx.fill();
    // голова
    ctx.fillStyle = SKIN;
    ctx.shadowColor = "rgba(240,192,144,.5)"; ctx.shadowBlur = fl ? 10 : 4;
    ctx.beginPath(); ctx.ellipse(0, -21*sc, 8.5*sc, 10*sc, 0, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    // лоб / лицо — тень
    ctx.fillStyle = "rgba(0,0,0,0.12)";
    ctx.beginPath(); ctx.ellipse(2*sc, -19*sc, 5*sc, 7*sc, 0.2, 0, Math.PI*2); ctx.fill();
    // глаза
    const eyeX = 3*sc, eyeY = -21*sc;
    ctx.fillStyle = "#1a1a2e";
    ctx.beginPath(); ctx.ellipse(eyeX, eyeY, 2.8*sc, 2.2*sc, 0, 0, Math.PI*2); ctx.fill();
    // радужка — синяя (как у тёмного рыцаря)
    ctx.fillStyle = fl ? "#88aaff" : "#2244aa";
    ctx.beginPath(); ctx.ellipse(eyeX, eyeY, 1.8*sc, 1.6*sc, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "#080810";
    ctx.beginPath(); ctx.arc(eyeX, eyeY, 1.1*sc, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "rgba(255,255,255,0.85)";
    ctx.beginPath(); ctx.arc(eyeX + 0.8*sc, eyeY - 0.8*sc, 0.7*sc, 0, Math.PI*2); ctx.fill();
    // бровь
    ctx.strokeStyle = HAIR; ctx.lineWidth = 1.5*sc; ctx.lineCap = "round";
    ctx.beginPath(); ctx.moveTo(eyeX - 3*sc, eyeY - 3*sc); ctx.lineTo(eyeX + 2.5*sc, eyeY - 3.5*sc); ctx.stroke();
    // нос
    ctx.strokeStyle = "rgba(160,120,80,0.6)"; ctx.lineWidth = sc;
    ctx.beginPath(); ctx.moveTo(3.5*sc, -20*sc); ctx.lineTo(4.5*sc, -17*sc); ctx.stroke();
    // рот — серьёзное выражение
    ctx.strokeStyle = "rgba(120,80,60,0.7)"; ctx.lineWidth = 1.2*sc;
    ctx.beginPath(); ctx.moveTo(1*sc, -16.5*sc); ctx.lineTo(5*sc, -16.5*sc); ctx.stroke();

    // --- ВОЛОСЫ (чёрные, торчащие) ---
    ctx.fillStyle = HAIR;
    // основа
    ctx.beginPath(); ctx.ellipse(0, -26*sc, 9*sc, 7*sc, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(-1*sc, -22*sc, 9*sc, 7*sc, -0.1, Math.PI, Math.PI*2); ctx.fill();
    // торчащие пряди
    const spikes = [[-6*sc,-28*sc,-9*sc,-36*sc,-4*sc,-30*sc],
                    [-2*sc,-30*sc, 0*sc,-39*sc, 3*sc,-31*sc],
                    [ 3*sc,-29*sc, 7*sc,-37*sc, 8*sc,-28*sc],
                    [ 7*sc,-27*sc,11*sc,-34*sc,10*sc,-24*sc]];
    spikes.forEach(([x1,y1,x2,y2,x3,y3])=>{
      ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.lineTo(x3,y3); ctx.closePath(); ctx.fill();
    });
    // боковые пряди
    ctx.beginPath(); ctx.moveTo(-8*sc,-24*sc); ctx.lineTo(-13*sc,-22*sc); ctx.lineTo(-8*sc,-18*sc); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(8*sc,-23*sc); ctx.lineTo(12*sc,-20*sc); ctx.lineTo(9*sc,-17*sc); ctx.closePath(); ctx.fill();

    // --- НАГОЛОВНИК (тонкий обруч с синим камнем) ---
    ctx.strokeStyle = ARMOR_L; ctx.lineWidth = 1.8*sc;
    ctx.beginPath(); ctx.arc(0, -22*sc, 9.2*sc, -2.3, -0.8); ctx.stroke();
    ctx.fillStyle = ARMOR_H; ctx.shadowColor = GLOW; ctx.shadowBlur = fl ? 12 : 6;
    ctx.beginPath(); ctx.ellipse(-1*sc, -30*sc, 2.5*sc, 3.2*sc, 0, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;

    ctx.restore();
  }
  _body(cx,cy,s,fl){
    const c=fl?this.flashC:this.color;
    const dk=darken(this.color,.45);
    const walk=(this.state==="move")?Math.sin(this.walkP):0;
    const f=this.facing;
    // ноги
    ctx.strokeStyle=dk; ctx.lineWidth=5*s; ctx.lineCap="round";
    ctx.beginPath(); ctx.moveTo(cx,cy+14*s); ctx.lineTo(cx-5*s+walk*7*s*f,cy+27*s); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx,cy+14*s); ctx.lineTo(cx+5*s-walk*7*s*f,cy+27*s); ctx.stroke();
    // торс — боковая грань (объём)
    const bw=13*s,bh=16*s,bx=cx-bw/2,by=cy-4*s;
    ctx.fillStyle=darken(this.color,.6);
    ctx.beginPath(); ctx.moveTo(bx+bw,by); ctx.lineTo(bx+bw+5*s*f,by-3*s);
    ctx.lineTo(bx+bw+5*s*f,by-3*s+bh); ctx.lineTo(bx+bw,by+bh); ctx.closePath(); ctx.fill();
    // верх торса
    ctx.fillStyle=lighten(this.color,.18);
    ctx.beginPath(); ctx.moveTo(bx,by); ctx.lineTo(bx+bw,by);
    ctx.lineTo(bx+bw+5*s*f,by-3*s); ctx.lineTo(bx+5*s*f,by-3*s); ctx.closePath(); ctx.fill();
    // передняя грань
    ctx.fillStyle=c; ctx.shadowColor=c; ctx.shadowBlur=fl?18:8;
    rrect(ctx,bx,by,bw,bh,3*s); ctx.shadowBlur=0;
    // голова — боковая
    ctx.fillStyle=darken(this.color,.52);
    ctx.beginPath(); ctx.ellipse(cx+5*s*f,cy-15*s,7*s,9*s,0,0,Math.PI*2); ctx.fill();
    // лицо
    ctx.fillStyle=fl?"#fff":"#f5d8b0"; ctx.shadowColor=fl?c:"rgba(245,216,176,.5)"; ctx.shadowBlur=fl?14:6;
    ctx.beginPath(); ctx.ellipse(cx,cy-14*s,9*s,9*s,0,0,Math.PI*2); ctx.fill(); ctx.shadowBlur=0;
    // глаз
    const ex=cx+f*9*s*.38, ey=cy-14*s-9*s*.1;
    ctx.fillStyle="#1a1a2e"; ctx.beginPath(); ctx.arc(ex,ey,9*s*.22,0,Math.PI*2); ctx.fill();
    ctx.fillStyle="rgba(255,255,255,.85)"; ctx.beginPath(); ctx.arc(ex+f*9*s*.08,ey-9*s*.08,9*s*.1,0,Math.PI*2); ctx.fill();
    // руки
    ctx.strokeStyle=dk; ctx.lineWidth=4*s; ctx.lineCap="round";
    ctx.beginPath(); ctx.moveTo(bx,by+3*s); ctx.lineTo(bx-8*s,by+12*s+walk*10*s); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(bx+bw,by+3*s); ctx.lineTo(bx+bw+8*s,by+12*s-walk*10*s); ctx.stroke();
    // оружие
    this._weapon(cx,cy,s,fl,c,f);
  }
  _weapon(cx,cy,s,fl,c,f){
    const wx=cx+f*(13*s+8*s);
    ctx.lineCap="round";
    if(this.role==="Мечник"){
      ctx.strokeStyle=fl?"#fff":"#b8d4ff"; ctx.lineWidth=3.5*s;
      ctx.beginPath(); ctx.moveTo(wx,cy-22*s); ctx.lineTo(wx,cy+8*s); ctx.stroke();
      ctx.strokeStyle=fl?"#fff":"#8888aa"; ctx.lineWidth=3*s;
      ctx.beginPath(); ctx.moveTo(wx-8*s,cy-6*s); ctx.lineTo(wx+8*s,cy-6*s); ctx.stroke();
      ctx.fillStyle=fl?"#fff":darken(c,.35); ctx.strokeStyle=fl?"#fff":"#5588aa"; ctx.lineWidth=2*s;
      rrPath(ctx,cx-f*(16*s)-6*s,cy-18*s,12*s,22*s,3*s); ctx.fill(); ctx.stroke();
    } else if(this.role==="Убийца"){
      [-1,1].forEach(side=>{
        const kx=cx+side*f*(11*s);
        ctx.strokeStyle=fl?"#fff":"#ffe0a0"; ctx.lineWidth=2.5*s;
        ctx.beginPath(); ctx.moveTo(kx,cy-18*s); ctx.lineTo(kx+side*f*5*s,cy+6*s); ctx.stroke();
      });
    } else if(this.role==="Маг"){
      ctx.strokeStyle=fl?"#fff":"#c782f5"; ctx.lineWidth=3*s;
      ctx.beginPath(); ctx.moveTo(wx,cy-26*s); ctx.lineTo(wx,cy+12*s); ctx.stroke();
      ctx.fillStyle=fl?"#fff":"#e0aaff"; ctx.shadowColor="#c782f5"; ctx.shadowBlur=14;
      ctx.beginPath(); ctx.arc(wx,cy-26*s,5*s+Math.sin(performance.now()*.004)*1.5*s,0,Math.PI*2); ctx.fill(); ctx.shadowBlur=0;
    } else {
      // монстр — когти
      ctx.strokeStyle=fl?"#fff":"#ff5533"; ctx.lineWidth=3.5*s;
      [-8,0,8].forEach(oy=>{
        ctx.beginPath(); ctx.moveTo(wx-f*4*s,cy+oy*s); ctx.lineTo(wx+f*10*s,cy+(oy+5)*s); ctx.stroke();
      });
    }
  }
  _hpbar(cx,ty){
    const bw=this.r*2.8, bh=5, bx=cx-bw/2;
    const pct=this.hp/this.maxHp;
    const col=pct>.6?"#4ec97a":pct>.3?"#f4be5f":"#f06058";
    ctx.fillStyle="rgba(0,0,0,.5)"; rrect(ctx,bx-1,ty-1,bw+2,bh+2,3);
    ctx.fillStyle=col; if(bw*pct>0) rrect(ctx,bx,ty,bw*pct,bh,3);
    ctx.save(); ctx.font="bold 11px Manrope,sans-serif"; ctx.textAlign="center";
    ctx.fillStyle="#ccddff"; ctx.shadowColor="rgba(0,0,0,.9)"; ctx.shadowBlur=5;
    ctx.fillText(this.name,cx,ty-3); ctx.restore();
  }
}

// ══ УРОН / СМЕРТЬ ══════════════════════════════════
function dealDmg(atk,tgt,dmg){
  if(!tgt||tgt.dead)return;
  if(tgt.isHero && tgt.spawnShield>0) return;
  tgt.hit(dmg);
  const p=w2c(tgt.wx,tgt.wz,.9);
  dmgt(p.cx,p.cy,`-${dmg}`,atk.isHero?"#f4be5f":"#f06058");
  addLog(`${atk.name} → ${tgt.name}: ${dmg} урона.`,atk.isHero?"good":"bad");
}
function onDeath(u){
  const p=w2c(u.wx,u.wz,.5);
  parts(p.cx,p.cy,u.color,16,4);
  addLog(`${u.name} пал!`,u.isHero?"bad":"good");
  if(u.isHero) setTimeout(()=>{gameState="defeat";},300);
}

// ══ ШАБЛОНЫ ГЕРОЕВ ════════════════════════════════
const HEROES={
  knight:{
    name:"Рагнар",role:"Мечник",portrait:"⚔️",
    hp:500,mp:0,spd:2.8,atk:[150,150],atkRange:1.25,atkCd:700,color:"#73a5ff",r:24,
    ab1Name:"Вихрь",ab1Max:5000,
    ab2Name:"Рывок",ab2Max:7000,
    ab1(p){ // AoE
      monsters.filter(m=>!m.dead&&dist2(p,m)<1.9).forEach(m=>{
        const d=rndI(38,58); dealDmg(p,m,d);
      });
      const c=w2c(p.wx,p.wz,.8); parts(c.cx,c.cy,"#73a5ff",22,5);
      addLog("Рагнар — Вихрь клинков!","info");
    },
    ab2(p){ // рывок
      const t=p.closest(); if(!t)return;
      const dx=t.wx-p.wx,dz=t.wz-p.wz,l=Math.hypot(dx,dz)||1;
      p.wx=clamp(t.wx-dx/l*1.1,.2,AW-.2); p.wz=clamp(t.wz-dz/l*1.1,.2,AD-.2);
      const d=rndI(50,70); dealDmg(p,t,d);
      addLog("Рагнар — Боевой рывок!","info");
    },
  },
  assassin:{
    name:"Лиора",role:"Убийца",portrait:"🗡️",
    hp:130,mp:0,spd:4.2,atk:[20,30],atkRange:1.0,atkCd:500,color:"#f4be5f",r:20,
    ab1Name:"Двойной удар",ab1Max:5000,
    ab2Name:"Яд",ab2Max:8000,
    ab1(p){
      const t=p.closest(); if(!t)return;
      dealDmg(p,t,rndI(30,44)); dealDmg(p,t,rndI(30,44));
      addLog("Лиора — Двойной удар!","info");
    },
    ab2(p){
      monsters.filter(m=>!m.dead&&dist2(p,m)<2.5).forEach(m=>{
        m.poisonTicks=6; m.poisonDmg=rndI(8,14); m.poisonTimer=0;
      });
      addLog("Лиора — Яд!","info");
    },
  },
  mage:{
    name:"Селена",role:"Маг",portrait:"🔮",
    hp:100,mp:120,spd:2.4,atk:[32,48],atkRange:3.2,atkCd:1600,color:"#c47aff",r:20,
    ab1Name:"Огн.шар",ab1Max:4000,
    ab2Name:"Метеор",ab2Max:10000,
    ab1(p){
      const t=p.closest(); if(!t)return;
      proj(p,t,rndI(58,78),"#ff9940",10);
      addLog("Селена — Огненный шар!","info");
    },
    ab2(p){
      monsters.filter(m=>!m.dead).forEach(m=>{
        const d=rndI(45,68); dealDmg(p,m,d);
        const c=w2c(m.wx,m.wz,.5); parts(c.cx,c.cy,"#ff5520",14,5);
      });
      addLog("Селена — МЕТЕОР!","info");
    },
  },
};

// ══ МОНСТРЫ ═════════════════════════════════════════
const MTMPL=[
  {name:"Серый волк", role:"Монстр",hp:200, spd:2.35,atk:[50,50],atkRange:1.08,atkCd:980, color:"#9da9b6",r:20,isBoss:false},
  {name:"Черный волк",role:"Босс",  hp:400, spd:1.95,atk:[150,150],atkRange:1.3,atkCd:980, color:"#222833",r:29,isBoss:true},
];
function makeMonster(wave){
  const isBossWave = wave > 0 && wave % 5 === 0;
  const tmpl = isBossWave ? MTMPL[1] : MTMPL[0];
  const baseScale = isBossWave ? 1 + (wave - 1) * 0.18 : 1 + (wave - 1) * 0.12;
  const m=new Unit({
    ...tmpl,
    hp:~~(tmpl.hp*baseScale), atk:[~~(tmpl.atk[0]*baseScale),~~(tmpl.atk[1]*baseScale)],
    spd:tmpl.spd*(1+(wave-1)*.04),
    wx:AW-1.5+rnd(-.4,.4), wz:rnd(.6,AD-.6),
    isHero:false, atkTimer:rnd(0,tmpl.atkCd),
  });
  m.isBoss = !!tmpl.isBoss;
  return m;
}
function makeWave(wave){
  if(wave > 0 && wave % 5 === 0){
    addLog("На арену выходит главный босс: Черный волк!", "bad");
    return [makeMonster(wave)];
  }
  const n=wave===1?1:Math.min(1+wave,7);
  return Array.from({length:n},()=>makeMonster(wave));
}

// ══ СОСТОЯНИЕ ИГРЫ ══════════════════════════════════
let player=null, monsters=[], wave=1, gameState="menu";
let wavePause=0, lastT=null, chosenKey=null;
let battleActive=false; // false = игрок ещё не дошёл до места боя

// ══ ВВОД ════════════════════════════════════════════
const keys={};
let mouseBtn=false;
window.addEventListener("keydown",e=>{
  keys[e.code]=true;
  if(["Space","KeyW","KeyA","KeyS","KeyD","ArrowUp","ArrowDown","ArrowLeft","ArrowRight"].includes(e.code))
    e.preventDefault();
  if(gameState!=="playing"||!player||player.dead)return;
  // Пробел — удар вручную
  if(e.code==="Space") playerManualSwing();
  if(e.code==="KeyQ"&&player.ab1Cd===0){
    player.ab1Cd=player.ab1Max;
    HEROES[chosenKey].ab1(player);
  }
  if(e.code==="KeyE"&&player.ab2Cd===0){
    player.ab2Cd=player.ab2Max;
    HEROES[chosenKey].ab2(player);
  }
});
window.addEventListener("keyup",e=>{ keys[e.code]=false; });
arena.addEventListener("mousedown",e=>{ if(e.button===0){ mouseBtn=true; if(gameState==="playing"&&player&&!player.dead) playerManualSwing(); } });
arena.addEventListener("mouseup",  e=>{ if(e.button===0) mouseBtn=false; });
arena.addEventListener("mouseleave",()=>{ mouseBtn=false; });

function playerManualSwing(){
  if(!player||player.dead)return;
  if(!battleActive)return; // бой ещё не начался
  if(player.atkTimer>0)return; // ещё на кулдауне
  const t=player.closest();
  if(!t||dist2(player,t)>player.atkRange+0.6)return;
  player.atkTimer=player.atkCd; player.atkAnim=1;
  if(player.role==="Маг") proj(player,t,player.atk[0],"#c47aff");
  else dealDmg(player,t,player.atk[0]);
}

function inputPlayer(dt){
  if(!player||player.dead)return;
  const s=player.spd*(dt/1000); let moved=false;
  if(keys["KeyW"]||keys["ArrowUp"])   {player.wz-=s;moved=true;}
  if(keys["KeyS"]||keys["ArrowDown"]) {player.wz+=s;moved=true;}
  if(keys["KeyA"]||keys["ArrowLeft"]) {player.wx-=s;player.facing=-1;moved=true;}
  if(keys["KeyD"]||keys["ArrowRight"]){player.wx+=s;player.facing=1; moved=true;}
  if(moved){
    player.state="move"; player.walkP+=dt*.008;
    player.wx=clamp(player.wx,.25,AW-.25); player.wz=clamp(player.wz,.25,AD-.25);
  } else if(player.state==="move"){
    player.state="idle";
  }
}

// ══ ЛОГ ════════════════════════════════════════════
const logEl=document.getElementById("log");
function addLog(text,kind="info"){
  const d=document.createElement("div");
  d.className=`log-item ${kind}`; d.textContent=text;
  logEl.prepend(d);
  while(logEl.children.length>30) logEl.lastElementChild.remove();
}

// ══ HUD ════════════════════════════════════════════
function updateHUD(){
  if(!player)return;
  const hp=clamp(player.hp/player.maxHp*100,0,100);
  const mp=player.maxMp>0?clamp(player.mp/player.maxMp*100,0,100):0;
  document.getElementById("hpBar").style.width=hp+"%";
  document.getElementById("hpVal").textContent=`${player.hp}/${player.maxHp}`;
  document.getElementById("mpBar").style.width=mp+"%";
  document.getElementById("mpVal").textContent=player.maxMp>0?`${player.mp}/${player.maxMp}`:"—";
  document.getElementById("mpRow").style.display=player.maxMp>0?"flex":"none";
  document.getElementById("waveNum").textContent=wave;
  document.getElementById("mobCount").textContent=monsters.filter(m=>!m.dead).length;
  // откаты — визуальная плашка сверху вниз
  const a1f=player.ab1Cd/player.ab1Max;
  const a2f=player.ab2Cd/player.ab2Max;
  document.getElementById("ab1Cd").style.transform=`scaleY(${a1f})`;
  document.getElementById("ab2Cd").style.transform=`scaleY(${a2f})`;
}

// ══ ОБЪЯВЛЕНИЕ ВОЛНЫ ════════════════════════════════
let ANN={text:"",alpha:0,timer:0};
function announce(t){ANN={text:t,alpha:1,timer:2200};}
function tickAnn(dt){ if(ANN.timer>0){ANN.timer-=dt;ANN.alpha=Math.min(1,ANN.timer/600);} }
function drawAnn(){
  if(ANN.alpha<=0)return;
  ctx.save(); ctx.globalAlpha=ANN.alpha; ctx.textAlign="center";
  ctx.font="bold 46px Cinzel,serif"; ctx.fillStyle="#f4be5f";
  ctx.shadowColor="#f4be5f"; ctx.shadowBlur=28;
  ctx.fillText(ANN.text,arena.width/2,arena.height*.17); ctx.restore();
}

// ══ ОВЕРЛЕЙ КОНЦА ══════════════════════════════════
function drawEnd(){
  ctx.save(); ctx.fillStyle="rgba(0,0,0,.7)"; ctx.fillRect(0,0,arena.width,arena.height);
  ctx.textAlign="center";
  const win=gameState==="victory";
  ctx.font="bold 56px Cinzel,serif";
  ctx.fillStyle=win?"#4ec97a":"#f06058"; ctx.shadowColor=ctx.fillStyle; ctx.shadowBlur=32;
  ctx.fillText(win?"ПОБЕДА!":"ПОРАЖЕНИЕ",arena.width/2,arena.height/2-20);
  ctx.font="bold 20px Manrope,sans-serif"; ctx.fillStyle="#ddeeff"; ctx.shadowBlur=10;
  ctx.fillText('Нажмите "Меню" для выхода',arena.width/2,arena.height/2+28);
  ctx.restore();
}

// ══ ФОНОВОЕ НЕБО ════════════════════════════════════
let stars=[];
function genStars(){ stars=Array.from({length:90},()=>({x:rnd(0,1),y:rnd(0,.65),r:rnd(.4,1.8),a:rnd(.25,.9)})); }
function drawSky(){
  const W=arena.width,H=arena.height;
  const g=ctx.createLinearGradient(0,0,0,H*.75);
  g.addColorStop(0,"#03070e"); g.addColorStop(1,"#0a1c35");
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  stars.forEach(s=>{
    ctx.globalAlpha=s.a; ctx.fillStyle="#fff";
    ctx.beginPath(); ctx.arc(s.x*W,s.y*H,s.r,0,Math.PI*2); ctx.fill();
  });
  ctx.globalAlpha=1;
  // горизонт-туман
  const fog=ctx.createLinearGradient(0,H*.5,0,H*.68);
  fog.addColorStop(0,"transparent"); fog.addColorStop(1,"rgba(10,28,52,.65)");
  ctx.fillStyle=fog; ctx.fillRect(0,H*.5,W,H*.18);
}

// ══ ГЛАВНЫЙ ЦИКЛ ════════════════════════════════════
function loop(ts){
  try {
    const dt=lastT?Math.min(ts-lastT,50):16; lastT=ts;

    if(gameState==="playing"){
      inputPlayer(dt);
      // Проверяем, дошёл ли игрок до места боя
      if(!battleActive && player && !player.dead && monsters.length>0){
        const nearest=monsters.reduce((best,m)=>{
          if(m.dead)return best;
          const d=dist2(player,m);
          return (!best||d<best.d)?{m,d}:best;
        },null);
        if(nearest && nearest.d<=3.5){
          battleActive=true;
          announce("БОЙ НАЧАЛСЯ!");
          addLog("Ты вошёл в зону боя!","bad");
        }
      }
      // обновить игрока (кулдауны)
      if(player&&!player.dead){
        player.atkTimer=Math.max(0,player.atkTimer-dt);
        player.ab1Cd=Math.max(0,player.ab1Cd-dt);
        player.ab2Cd=Math.max(0,player.ab2Cd-dt);
        if(player.atkAnim>0) player.atkAnim=Math.max(0,player.atkAnim-dt/280);
        player.spawnShield=Math.max(0,player.spawnShield-dt);
        // нет автоатаки — игрок управляет сам (ЛКМ / Пробел)
      }
      // монстры
      monsters.forEach(m=>{
        m.aiUpdate(dt);
        if(m.poisonTicks>0){
          m.poisonTimer-=dt;
          if(m.poisonTimer<=0){
            m.poisonTimer=800; m.poisonTicks--;
            dealDmg(player,m,m.poisonDmg);
            const c=w2c(m.wx,m.wz,.5); parts(c.cx,c.cy,"#80ff80",4,2);
          }
        }
      });
      tickProj(dt); tickParts(dt); tickDmgt(dt); tickAnn(dt);
      // конец волны?
      if(monsters.every(m=>m.dead)){
        wavePause+=dt;
        if(wavePause>2000){
          wavePause=0; wave++;
          battleActive=false;
          monsters=makeWave(wave);
          announce(`Волна ${wave} — найди врагов!`);
          addLog(`Волна ${wave}: иди к месту боя!`,"info");
        }
      }
      updateHUD();
    } else {
      tickParts(dt); tickDmgt(dt);
    }

    // ── Рисование ──────────────────────────────────────
    ctx.clearRect(0,0,arena.width,arena.height);
    drawSky(); drawWalls(); drawFloor();
    // сортировка по глубине (wz)
    [...monsters,player?player:[]].flat().filter(u=>u&&!u.dead).sort((a,b)=>a.wz-b.wz).forEach(u=>u.draw());
    [...monsters,player?player:[]].flat().filter(u=>u&&u.dead).forEach(u=>u.draw());
    drawProj(); drawParts(); drawDmgt(); drawAnn();
    if(gameState==="playing" && !battleActive) drawApproachHint();
    if(gameState==="defeat"||gameState==="victory") drawEnd();
  } catch (err) {
    console.error("Render loop error:", err);
    ctx.clearRect(0,0,arena.width,arena.height);
    ctx.fillStyle="#000"; ctx.fillRect(0,0,arena.width,arena.height);
    ctx.fillStyle="#f06058"; ctx.font="bold 22px Manrope,sans-serif"; ctx.textAlign="center";
    ctx.fillText("Ошибка рендера. Нажмите Меню и выберите бойца снова.", arena.width/2, arena.height/2);
  }

  requestAnimationFrame(loop);
}

// ══ ПОДСКАЗКА ПОДХОДА ══════════════════════════════
function drawApproachHint(){
  if(!monsters.length)return;
  // Центр группы монстров
  const alive=monsters.filter(m=>!m.dead);
  if(!alive.length)return;
  const cx=alive.reduce((s,m)=>s+m.wx,0)/alive.length;
  const cz=alive.reduce((s,m)=>s+m.wz,0)/alive.length;
  const sc=w2c(cx,cz,0);
  const t=performance.now();
  // Пульсирующий круг на полу
  const pulse=0.55+0.45*Math.sin(t*0.004);
  ctx.save();
  ctx.globalAlpha=0.22*pulse;
  ctx.fillStyle="#f4be5f";
  ctx.beginPath();
  ctx.ellipse(sc.cx, sc.cy, 68*pulse, 22*pulse, 0, 0, Math.PI*2);
  ctx.fill();
  ctx.globalAlpha=0.55*pulse;
  ctx.strokeStyle="#f4be5f";
  ctx.lineWidth=2.5;
  ctx.beginPath();
  ctx.ellipse(sc.cx, sc.cy, 68*pulse, 22*pulse, 0, 0, Math.PI*2);
  ctx.stroke();
  ctx.restore();
  // Стрелка-указатель от игрока к монстрам
  if(!player)return;
  const ps=w2c(player.wx,player.wz,1);
  const dx=sc.cx-ps.cx, dy=sc.cy-ps.cy;
  const dist=Math.hypot(dx,dy);
  if(dist<60)return;
  const nx=dx/dist, ny=dy/dist;
  const arrowX=ps.cx+nx*60, arrowY=ps.cy+ny*60;
  ctx.save();
  ctx.globalAlpha=0.75+0.25*Math.sin(t*0.006);
  ctx.strokeStyle="#f4be5f"; ctx.lineWidth=3; ctx.lineCap="round";
  ctx.shadowColor="#f4be5f"; ctx.shadowBlur=12;
  ctx.beginPath(); ctx.moveTo(arrowX, arrowY); ctx.lineTo(arrowX+nx*40, arrowY+ny*40); ctx.stroke();
  // наконечник стрелки
  const angle=Math.atan2(ny,nx);
  ctx.beginPath();
  ctx.moveTo(arrowX+nx*40, arrowY+ny*40);
  ctx.lineTo(arrowX+nx*40-14*Math.cos(angle-0.45), arrowY+ny*40-14*Math.sin(angle-0.45));
  ctx.moveTo(arrowX+nx*40, arrowY+ny*40);
  ctx.lineTo(arrowX+nx*40-14*Math.cos(angle+0.45), arrowY+ny*40-14*Math.sin(angle+0.45));
  ctx.stroke();
  // Текст
  ctx.font="bold 17px Manrope,sans-serif"; ctx.textAlign="center";
  ctx.fillStyle="#f4be5f"; ctx.shadowBlur=16;
  ctx.fillText("Иди к месту боя!", arena.width/2, arena.height*0.12);
  ctx.restore();
}

// ══ МЕНЮ — ПРЕВЬЮ ГЕРОЕВ ════════════════════════════
function drawMenuBg(){
  const mc=document.getElementById("menuBg");
  mc.width=window.innerWidth; mc.height=window.innerHeight;
  const c=mc.getContext("2d");
  const g=c.createLinearGradient(0,0,0,mc.height);
  g.addColorStop(0,"#03070e"); g.addColorStop(1,"#0b1c36");
  c.fillStyle=g; c.fillRect(0,0,mc.width,mc.height);
  for(let i=0;i<140;i++){
    c.globalAlpha=rnd(.15,.75); c.fillStyle="#fff";
    c.beginPath(); c.arc(rnd(0,mc.width),rnd(0,mc.height*.75),rnd(.3,1.6),0,Math.PI*2); c.fill();
  }
  c.globalAlpha=1;
  // glow spots
  [["#4466ff",.22,mc.width*.15,mc.height*.8],["#9944cc",.18,mc.width*.5,mc.height*.9],["#ff5522",.18,mc.width*.82,mc.height*.85]].forEach(([col,a,x,y])=>{
    c.globalAlpha=a; const rg=c.createRadialGradient(x,y,0,x,y,240);
    rg.addColorStop(0,col); rg.addColorStop(1,"transparent");
    c.fillStyle=rg; c.fillRect(0,0,mc.width,mc.height);
  });
  c.globalAlpha=1;
}

const PDATA={knight:{color:"#73a5ff",role:"Мечник"},assassin:{color:"#f4be5f",role:"Убийца"},mage:{color:"#c47aff",role:"Маг"}};
function drawPreview(canvas,key){
  const c=canvas.getContext("2d"), W=canvas.width, H=canvas.height;
  c.clearRect(0,0,W,H);
  const g=c.createRadialGradient(W/2,H/2,0,W/2,H/2,W/2);
  g.addColorStop(0,"rgba(20,40,80,.55)"); g.addColorStop(1,"rgba(3,8,18,.92)");
  c.fillStyle=g; c.fillRect(0,0,W,H);
  // тень
  c.globalAlpha=.3; c.fillStyle="#000";
  c.beginPath(); c.ellipse(W/2,H*.85,36,11,0,0,Math.PI*2); c.fill(); c.globalAlpha=1;

  if(key==="knight" && swordsmanImg.complete && swordsmanImg.naturalWidth>0){
    const img = swordsmanImg;
    const sw = img.naturalWidth * 0.44;
    const sh = img.naturalHeight * 0.92;
    const sx = img.naturalWidth * 0.29;
    const sy = img.naturalHeight * 0.04;
    const dh = H * 0.92;
    const dw = dh * 0.8;
    c.drawImage(img, sx, sy, sw, sh, W/2-dw/2, H*0.1, dw, dh);
    return;
  }

  const col=PDATA[key].color, role=PDATA[key].role;
  const cx=W/2, cy=H*.6, s=1.28, f=1;
  const dk=(h,a)=>{try{const[r,g,b]=hexRGB(h);return`rgb(${~~(r*a)},${~~(g*a)},${~~(b*a)})`;}catch{return h;}};
  const lk=(h,a)=>{try{const[r,g,b]=hexRGB(h);return`rgb(${~~(r+(255-r)*a)},${~~(g+(255-g)*a)},${~~(b+(255-b)*a)})`;}catch{return h;}};

  // ноги
  c.strokeStyle=dk(col,.45); c.lineWidth=5*s; c.lineCap="round";
  c.beginPath(); c.moveTo(cx,cy+14*s); c.lineTo(cx-5*s,cy+28*s); c.stroke();
  c.beginPath(); c.moveTo(cx,cy+14*s); c.lineTo(cx+5*s,cy+28*s); c.stroke();
  // торс
  const bw=13*s,bh=16*s,bx=cx-bw/2,by=cy-4*s;
  c.fillStyle=dk(col,.6);
  c.beginPath(); c.moveTo(bx+bw,by); c.lineTo(bx+bw+5*s,by-3*s);
  c.lineTo(bx+bw+5*s,by-3*s+bh); c.lineTo(bx+bw,by+bh); c.closePath(); c.fill();
  c.fillStyle=lk(col,.18);
  c.beginPath(); c.moveTo(bx,by); c.lineTo(bx+bw,by); c.lineTo(bx+bw+5*s,by-3*s); c.lineTo(bx+5*s,by-3*s); c.closePath(); c.fill();
  c.fillStyle=col; c.shadowColor=col; c.shadowBlur=18;
  rrPath(c,bx,by,bw,bh,3*s); c.fill(); c.shadowBlur=0;
  // голова
  c.fillStyle=dk(col,.52);
  c.beginPath(); c.ellipse(cx+5*s,cy-15*s,7*s,9*s,0,0,Math.PI*2); c.fill();
  c.fillStyle="#f5d8b0"; c.shadowColor="rgba(245,216,176,.4)"; c.shadowBlur=8;
  c.beginPath(); c.arc(cx,cy-14*s,9*s,0,Math.PI*2); c.fill(); c.shadowBlur=0;
  c.fillStyle="#1a1a2e"; c.beginPath(); c.arc(cx+4*s,cy-15.5*s,2.2*s,0,Math.PI*2); c.fill();
  c.fillStyle="rgba(255,255,255,.8)"; c.beginPath(); c.arc(cx+4.8*s,cy-16.2*s,1*s,0,Math.PI*2); c.fill();
  // руки
  c.strokeStyle=dk(col,.45); c.lineWidth=4*s; c.lineCap="round";
  c.beginPath(); c.moveTo(bx,by+3*s); c.lineTo(bx-8*s,by+14*s); c.stroke();
  c.beginPath(); c.moveTo(bx+bw,by+3*s); c.lineTo(bx+bw+8*s,by+14*s); c.stroke();
  // оружие
  const wx=cx+(13*s+8*s);
  if(role==="Мечник"){
    c.strokeStyle="#b8d4ff"; c.lineWidth=3.5*s;
    c.beginPath(); c.moveTo(wx,cy-22*s); c.lineTo(wx,cy+8*s); c.stroke();
    c.strokeStyle="#8888aa"; c.lineWidth=3*s;
    c.beginPath(); c.moveTo(wx-8*s,cy-6*s); c.lineTo(wx+8*s,cy-6*s); c.stroke();
    c.fillStyle=dk(col,.35); c.strokeStyle="#5588aa"; c.lineWidth=2*s;
    rrPath(c,cx-16*s-6*s,cy-18*s,12*s,22*s,3*s); c.fill(); c.stroke();
  } else if(role==="Убийца"){
    [-1,1].forEach(side=>{
      c.strokeStyle="#ffe0a0"; c.lineWidth=2.5*s;
      c.beginPath(); c.moveTo(cx+side*11*s,cy-18*s); c.lineTo(cx+side*16*s,cy+6*s); c.stroke();
    });
  } else {
    c.strokeStyle="#c782f5"; c.lineWidth=3*s;
    c.beginPath(); c.moveTo(wx,cy-28*s); c.lineTo(wx,cy+14*s); c.stroke();
    c.fillStyle="#e0aaff"; c.shadowColor="#c782f5"; c.shadowBlur=16;
    c.beginPath(); c.arc(wx,cy-28*s,6*s,0,Math.PI*2); c.fill(); c.shadowBlur=0;
  }
}

function initMenuPreviews(){
  drawMenuBg();
  document.querySelectorAll(".hero-preview").forEach(cv=>{
    drawPreview(cv, cv.closest(".hero-card").dataset.hero);
  });
}

// ══ ВЫБОР ГЕРОЯ ════════════════════════════════════
document.querySelectorAll(".hero-card").forEach(card=>{
  card.addEventListener("click",()=>{
    document.querySelectorAll(".hero-card").forEach(c=>c.classList.remove("selected"));
    card.classList.add("selected");
    chosenKey=card.dataset.hero;
    document.getElementById("startBtn").disabled=false;
  });
});

// ══ СТАРТ ИГРЫ ═════════════════════════════════════
function startGame(){
  if(!chosenKey)return;
  const tmpl=HEROES[chosenKey];
  player=new Unit({
    name:tmpl.name, role:tmpl.role, portrait:tmpl.portrait,
    hp:tmpl.hp, mp:tmpl.mp, spd:tmpl.spd,
    atk:tmpl.atk, atkRange:tmpl.atkRange, atkCd:tmpl.atkCd,
    color:tmpl.color, r:tmpl.r, isHero:true,
    ab1Max:tmpl.ab1Max, ab2Max:tmpl.ab2Max,
    wx:2, wz:AD/2, atkTimer:0,
  });
  player.ab1Cd=0; player.ab2Cd=0;
  player.spawnShield=0;
  battleActive=false;
  monsters=makeWave(1); wave=1; gameState="playing";
  wavePause=0; lastT=null;
  PARTS.length=0; PROJ.length=0; DMGT.length=0;
  logEl.innerHTML="";
  announce("Волна 1");
  addLog("Иди к врагам — бой начнётся когда подойдёшь!","info");
  document.getElementById("hudName").textContent=tmpl.name;
  document.getElementById("hudPortrait").textContent=tmpl.portrait;
  document.getElementById("ab1Name").textContent=tmpl.ab1Name;
  document.getElementById("ab2Name").textContent=tmpl.ab2Name;
  document.getElementById("menuScreen").classList.remove("active");
  document.getElementById("gameScreen").classList.add("active");
  resizeCam(); genStars();
}

document.getElementById("startBtn").addEventListener("click",startGame);
document.getElementById("menuBtn").addEventListener("click",()=>{
  gameState="menu";
  document.getElementById("gameScreen").classList.remove("active");
  document.getElementById("menuScreen").classList.add("active");
  document.querySelectorAll(".hero-card").forEach(c=>c.classList.remove("selected"));
  document.getElementById("startBtn").disabled=true;
  chosenKey=null;
});

// ══ ИНИЦИАЛИЗАЦИЯ ══════════════════════════════════
window.addEventListener("load", initMenuPreviews);
window.addEventListener("resize",()=>{ initMenuPreviews(); if(gameState==="playing") resizeCam(); });
swordsmanImg.addEventListener("load",()=>{
  if(document.readyState!=="loading") initMenuPreviews();
});
requestAnimationFrame(loop);
